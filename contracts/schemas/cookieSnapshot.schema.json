{
  "$id": "https://ja3proxy.invalid/contracts/cookieSnapshot.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CookieRecord": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "expiresAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hostOnly": {
          "type": "boolean"
        },
        "httpOnly": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "partitioned": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "sameSite": {
          "anyOf": [
            {
              "$ref": "#/definitions/CookieSameSite"
            },
            {
              "type": "null"
            }
          ]
        },
        "secure": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "domain",
        "path",
        "secure",
        "httpOnly",
        "hostOnly",
        "partitioned"
      ],
      "type": "object"
    },
    "CookieSameSite": {
      "enum": [
        "Strict",
        "Lax",
        "None"
      ],
      "type": "string"
    }
  },
  "properties": {
    "cookies": {
      "items": {
        "$ref": "#/definitions/CookieRecord"
      },
      "type": "array"
    },
    "partitionKey": {
      "type": "string"
    }
  },
  "required": [
    "partitionKey",
    "cookies"
  ],
  "title": "CookieSnapshot",
  "type": "object"
}
